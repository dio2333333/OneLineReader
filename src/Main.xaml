<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="一行 · Reader" Width="1050" Height="740" MinWidth="920" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#F5F6F2" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#223C32">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#26745C"/>
  <Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#315548"/><Setter Property="BorderBrush" Value="#DCE4DD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#26745C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#CDDED4"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,14"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#DCE4DD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#718076"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#193E30"><Grid Margin="18,30,18,20"><Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="*"/><RowDefinition Height="110"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="一 行" FontSize="30" FontWeight="SemiBold" Foreground="#F0F6EE"/><TextBlock Text="READER / 轻阅读" FontSize="10" Foreground="#A9C4B4" Margin="2,10,0,0"/></StackPanel>
   <StackPanel Grid.Row="1"><Button x:Name="NavBooks" Content="书架" Style="{StaticResource Nav}"/><Button x:Name="NavAppearance" Content="阅读外观" Style="{StaticResource Nav}"/><Button x:Name="NavKeys" Content="快捷操作" Style="{StaticResource Nav}"/><Button x:Name="NavReader" Content="Reader 同步" Style="{StaticResource Nav}"/></StackPanel>
   <StackPanel Grid.Row="2" VerticalAlignment="Bottom"><TextBlock Text="一点空闲，一行故事。" Foreground="#A9C4B4" FontSize="11"/><Border Height="1" Background="#365748" Margin="0,16"/><TextBlock x:Name="SideBoss" Text="Alt + V  隐藏 / 恢复" Foreground="#D7E6DD" FontSize="11"/><TextBlock Text="v1.0.4 · Windows 原生" Foreground="#87AB97" FontSize="10" Margin="0,10,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="32,28,32,20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="BooksView">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="把故事，藏在一行里。" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="本地阅读，或从 Reader 继续上一次的故事。" Style="{StaticResource Caption}" Margin="0,9,0,22"/></StackPanel>
    <Border Grid.Row="1" Background="#E5EDE3" CornerRadius="10" Padding="18,14" Margin="0,0,0,22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="只留一行，安静阅读" FontWeight="SemiBold"/><TextBlock Text="悬浮置顶 · 鼠标 / 键盘翻页 · 一键隐藏" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><Button x:Name="DemoButton" Grid.Column="1" Content="试读示例 →" Background="#F8FBF5" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid></Border>
    <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="SourceBox" SelectedIndex="0" Margin="0,0,10,0"><ComboBoxItem Content="本地书架"/><ComboBoxItem Content="Reader 书架"/><ComboBoxItem Content="Reader 在线书库"/></ComboBox><TextBox x:Name="SearchBox" Grid.Column="1" ToolTip="输入书名或作者，按 Enter 搜索"/><Button x:Name="RefreshButton" Grid.Column="2" Content="搜索 / 刷新" Margin="10,0,8,0"/><Button x:Name="ImportButton" Grid.Column="3" Content="＋ 导入" Style="{StaticResource Primary}" Margin="0"/></Grid>
    <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="BookList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.Resources><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" CornerRadius="9" BorderThickness="1" BorderBrush="#E0E6DF" Background="White" Padding="15,13"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#EBF3E9"/><Setter TargetName="Card" Property="BorderBrush" Value="#6B9C7D"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#98B5A2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.Resources><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="45" Background="#E4ECE2" CornerRadius="4" HorizontalAlignment="Left"><TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#497B5E"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#7C8A7F" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Position}" Foreground="#668171" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyBooks" Text="这里还没有书。导入 TXT / EPUB，或连接 Reader。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7F8E82" IsHitTestVisible="False" Visibility="Collapsed"/><Grid Grid.Row="1" Margin="0,4,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CountLabel" Text="本地书架" Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button x:Name="PrevBooks" Grid.Column="1" Content="上一页" Padding="10,5" Visibility="Collapsed"/><Button x:Name="NextBooks" Grid.Column="2" Content="下一页" Padding="10,5" Visibility="Collapsed" Margin="0"/></Grid></Grid>
    <Border Grid.Row="4" Background="White" CornerRadius="10" BorderBrush="#DEE5DD" BorderThickness="1" Padding="17"><StackPanel><TextBlock Text="正在阅读" Style="{StaticResource Caption}"/><TextBlock x:Name="CurrentTitle" Text="还没有打开书籍" FontWeight="SemiBold" FontSize="15" Margin="0,7,0,4" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CurrentChapter" Text="选择书籍后，点击开始阅读。" Style="{StaticResource Caption}"/><TextBlock x:Name="SyncDetail" Text="本机进度自动保存" Style="{StaticResource Caption}" Margin="0,8,0,0"/><WrapPanel Margin="0,14,0,0"><Button x:Name="ReadButton" Content="开始 / 继续阅读" Style="{StaticResource Primary}"/><Button x:Name="TocButton" Content="章节目录"/><Button x:Name="SyncButton" Content="立即同步"/></WrapPanel><WrapPanel x:Name="ConflictPanel" Visibility="Collapsed" Margin="0,12,0,0"><Button x:Name="KeepLocal" Content="保留本机位置"/><Button x:Name="UseCloud" Content="采用云端位置"/></WrapPanel></StackPanel></Border>
   </Grid>
   <ScrollViewer x:Name="AppearanceView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><TextBlock Text="阅读外观" Style="{StaticResource Section}"/><TextBlock Text="即时生效。调整阅读条，让它适合你的桌面。" Style="{StaticResource Caption}" Margin="0,0,0,22"/>
    <Border Background="#E4EBE0" CornerRadius="10" Padding="18" Margin="0,0,0,24"><StackPanel><TextBlock Text="实时预览" Style="{StaticResource Caption}" Margin="0,0,0,12"/><Border x:Name="PreviewBorder" CornerRadius="6" Padding="12" ClipToBounds="True"><TextBlock x:Name="PreviewText" Text="山风吹过桥面，故事刚刚开始。" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></Border></StackPanel></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="50"/><RowDefinition Height="50"/><RowDefinition Height="50"/><RowDefinition Height="50"/><RowDefinition Height="50"/><RowDefinition Height="55"/><RowDefinition Height="55"/><RowDefinition Height="42"/></Grid.RowDefinitions>
     <TextBlock Text="字体" VerticalAlignment="Center"/><ComboBox x:Name="FontBox" Grid.Column="1" Grid.ColumnSpan="2" IsEditable="True" Height="34"/>
     <TextBlock Grid.Row="1" Text="字号" VerticalAlignment="Center"/><Slider x:Name="FontSlider" Grid.Row="1" Grid.Column="1" Minimum="10" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/><TextBlock x:Name="FontValue" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
     <TextBlock Grid.Row="2" Text="阅读条宽度" VerticalAlignment="Center"/><Slider x:Name="WidthSlider" Grid.Row="2" Grid.Column="1" Minimum="240" Maximum="2000" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"/><TextBlock x:Name="WidthValue" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
     <TextBlock Grid.Row="3" Text="阅读条高度" VerticalAlignment="Center"/><Slider x:Name="HeightSlider" Grid.Row="3" Grid.Column="1" Minimum="28" Maximum="150" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/><TextBlock x:Name="HeightValue" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
     <TextBlock Grid.Row="4" Text="整体不透明度" VerticalAlignment="Center"/><Slider x:Name="OpacitySlider" Grid.Row="4" Grid.Column="1" Minimum="15" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/><TextBlock x:Name="OpacityValue" Grid.Row="4" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
     <TextBlock Grid.Row="5" Text="背景不透明度" VerticalAlignment="Center"/><Slider x:Name="BgSlider" Grid.Row="5" Grid.Column="1" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/><TextBlock x:Name="BgValue" Grid.Row="5" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
     <TextBlock Grid.Row="6" Text="文字颜色" VerticalAlignment="Center"/><TextBox x:Name="TextColorBox" Grid.Row="6" Grid.Column="1" Text="#DCE6DF" Height="34"/><Button x:Name="TextColorPick" Grid.Row="6" Grid.Column="2" Content="选取" Padding="8" Margin="8,0,0,0" Height="34"/>
     <TextBlock Grid.Row="7" Text="背景颜色" VerticalAlignment="Center"/><TextBox x:Name="BgColorBox" Grid.Row="7" Grid.Column="1" Text="#192A24" Height="34"/><Button x:Name="BgColorPick" Grid.Row="7" Grid.Column="2" Content="选取" Padding="8" Margin="8,0,0,0" Height="34"/>
     <WrapPanel Grid.Row="8" Grid.ColumnSpan="3" VerticalAlignment="Center"><CheckBox x:Name="TopCheck" Content="始终置顶" Margin="0,0,30,0"/><CheckBox x:Name="ProgressCheck" Content="底部进度细线"/></WrapPanel>
    </Grid><WrapPanel Margin="0,15,0,0"><Button x:Name="PresetDark" Content="深色"/><Button x:Name="PresetPaper" Content="纸色"/><Button x:Name="PresetQuiet" Content="低调灰"/><Button x:Name="ResetPosition" Content="移回屏幕内"/></WrapPanel><TextBlock Text="背景最低 1%，让阅读条的空白处也能接收鼠标操作。阅读条右下角可拖动调宽。" Style="{StaticResource Caption}" Margin="0,18,0,12"/>
   </StackPanel></ScrollViewer>
   <ScrollViewer x:Name="KeysView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="快捷操作" Style="{StaticResource Section}"/><TextBlock Text="点击输入框，直接按 F1、F2 等功能键，或 Ctrl / Alt / Shift 组合键。" Style="{StaticResource Caption}" Margin="0,0,0,24"/>
    <Border Background="White" CornerRadius="10" Padding="22"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="54"/><RowDefinition Height="54"/><RowDefinition Height="54"/></Grid.RowDefinitions><TextBlock Text="老板键 · 隐藏 / 恢复" VerticalAlignment="Center"/><TextBox x:Name="BossKeyBox" Grid.Column="1" Height="34"/><TextBlock Grid.Row="1" Text="全局下一行" VerticalAlignment="Center"/><TextBox x:Name="NextKeyBox" Grid.Row="1" Grid.Column="1" Height="34"/><TextBlock Grid.Row="2" Text="全局上一行" VerticalAlignment="Center"/><TextBox x:Name="PrevKeyBox" Grid.Row="2" Grid.Column="1" Height="34"/><TextBlock Grid.Row="3" Text="打开控制台" VerticalAlignment="Center"/><TextBox x:Name="ManagerKeyBox" Grid.Row="3" Grid.Column="1" Height="34"/></Grid><Button x:Name="SaveKeys" Content="保存快捷键" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,16,0,0"/><TextBlock x:Name="HotkeyStatus" Text="正在注册全局快捷键…" TextWrapping="Wrap" Foreground="#8B623C" Margin="0,12,0,0" LineHeight="22"/></StackPanel></Border>
    <TextBlock Text="阅读条内" FontSize="16" FontWeight="SemiBold" Margin="0,28,0,12"/><TextBlock Text="左键 / 滚轮向下 / → / Space：下一行&#10;滚轮向上 / ← / PageUp：上一行&#10;右键：菜单与章节目录　　Esc：立即隐藏&#10;左键拖动：移动阅读条　　右下角拖动：调整宽度" Foreground="#64796A" LineHeight="30"/>
    <StackPanel Orientation="Horizontal" Margin="0,24,0,0"><TextBlock Text="自动翻页间隔（秒）" VerticalAlignment="Center"/><TextBox x:Name="AutoSecondsBox" Width="65" Margin="15,0"/><Button x:Name="SaveAuto" Content="保存"/></StackPanel>
   </StackPanel></ScrollViewer>
   <StackPanel x:Name="ReaderView" Visibility="Collapsed"><TextBlock Text="连接 Reader" Style="{StaticResource Section}"/><TextBlock Text="同一个书架，同一段故事。在电脑和网页之间接着读。" Style="{StaticResource Caption}" Margin="0,0,0,24"/>
    <Border Background="White" CornerRadius="10" Padding="24"><StackPanel><TextBlock Text="Reader 服务地址" Margin="0,0,0,8"/><TextBox x:Name="ServerBox"/><TextBlock Text="填写你自己的 Reader 站点地址，支持反向代理子路径。对接 API v1。" Style="{StaticResource Caption}" Margin="0,7,0,18"/><TextBlock Text="用户名" Margin="0,0,0,8"/><TextBox x:Name="UsernameBox"/><TextBlock Text="密码" Margin="0,18,0,8"/><PasswordBox x:Name="PasswordBox" Padding="10,9" BorderBrush="#DCE4DD" BorderThickness="1"/><WrapPanel Margin="0,22,0,0"><Button x:Name="ConnectButton" Content="登录并同步书架" Style="{StaticResource Primary}"/><Button x:Name="TestConnection" Content="测试连接"/><Button x:Name="LogoutButton" Content="退出登录"/></WrapPanel><TextBlock x:Name="ConnectionLabel" Text="尚未登录" Foreground="#4E7F5F" Margin="0,18,0,0" TextWrapping="Wrap"/></StackPanel></Border>
    <Border Background="#E5EDE3" CornerRadius="8" Padding="16" Margin="0,20,0,0"><TextBlock Text="自动同步：停翻 30 秒且有新进度时上传；每 5 分钟保底握手并检查云端，与是否翻页无关。隐藏、收起、切书、退出时保存并尝试上传，打开 / 恢复时检查云端。没有新进度不重复上传，切换软件不会触发同步。" Foreground="#5C7662" TextWrapping="Wrap" LineHeight="23"/></Border><TextBlock x:Name="HttpNotice" Visibility="Collapsed" Text="当前地址使用 HTTP，账号和阅读内容会以明文传输；可改用服务器的 HTTPS 地址。" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
   </StackPanel>
   <Border Grid.Row="1" BorderBrush="#DEE5DD" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,13,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusLabel" Text="就绪" Foreground="#758878" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center"/><Button x:Name="HideButton" Grid.Column="1" Content="收起控制台" FontSize="11" Padding="10,5" Margin="12,0,0,0"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
